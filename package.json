{
  "name": "vina-tin-duc",
  "version": "1.0.0",
  "private": true,
  "description": "Corporate website for VINA TIN DUC COMPANY LIMITED",
  "scripts": {
    "cms:dev": "pnpm --dir cms develop",
    "cms:build": "pnpm --dir cms build",
    "cms:start": "pnpm --dir cms start",
    "web:dev": "pnpm --dir web dev",
    "web:build": "pnpm --dir web build",
    "web:preview": "pnpm --dir web preview",
    "web:lint": "pnpm --dir web lint",
    "web:typecheck": "pnpm --dir web typecheck",
    "web:test": "pnpm --dir web test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "seed": "node scripts/seed.mjs",
    "install:all": "pnpm install"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "core-js-pure",
      "esbuild",
      "sharp"
    ]
  }
}
