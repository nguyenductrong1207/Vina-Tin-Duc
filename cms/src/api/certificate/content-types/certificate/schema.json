{
  "kind": "collectionType",
  "collectionName": "certificates",
  "info": {
    "singularName": "certificate",
    "pluralName": "certificates",
    "displayName": "Certificate",
    "description": "Company certificates and documents"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "document": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images", "files"]
    },
    "issueDate": {
      "type": "date"
    },
    "expiryDate": {
      "type": "date"
    },
    "documentType": {
      "type": "enumeration",
      "enum": ["certificate", "license", "registration", "award", "other"],
      "default": "certificate"
    }
  }
}
